# OpenRouter — generation uses paid, structured-output models with a fallback.
# Create a key with available credits at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pin one model that supports JSON schema output (disables fallback).
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# Upstash Redis (REST) — caches explanations and the "latest explained" list.
# Create a free DB at https://console.upstash.com . The app still runs without it;
# Next.js continues to cache generated pages.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL, used for canonical/OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.siteexplainer.com
